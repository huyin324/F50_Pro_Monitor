{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "F50_Pro_Monitor",
  "version": "1.0.1",
  "identifier": "com.f50pro.monitor",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://127.0.0.1:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "F50 Pro Monitor · 中兴 F50 Pro 监控工具",
        "width": 1180,
        "height": 800,
        "minWidth": 900,
        "minHeight": 620,
        "resizable": true,
        "decorations": true,
        "transparent": false,
        "center": true,
        "visible": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis", "msi"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico"
    ],
    "shortDescription": "中兴 F50 Pro 状态监控与短信管理工具",
    "longDescription": "基于设备原生 80 端口 goform 接口，完整支持 F50 Pro 的硬件连接状态、实时速率、月度流量套餐、短信收发与设备信息查看。"
  }
}
