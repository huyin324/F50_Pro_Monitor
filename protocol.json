  "sms": {
    "path": "/goform/goform_get_cmd_process?multi_data=1&isTest=false&cmd=sms_data_total&page={page}&data_per_page={size}&mem_store={mem}&tags={tags}&order_by=order%20by%20id%20desc",
    "primary": { "mem_store": 1, "tags": 100, "page": 0, "page_size": 100 },
    "fallback": { "mem_store": 0, "tags": 10, "page": 0, "page_size": 100 },
    "_note": "真机验证：F50 Pro 使用 SIM/设备统一存储，mem_store=1&tags=100 与 mem_store=0&tags=10 均能取回全部短信；tags=1 仅取未读。原版 Windows 端从 2333 端口 UFI 代理 /api/goform 读取，F50 Pro 未开放该端口，这正是『无法查看短信』的根因。",
    "date_format": "YY,MM,DD,HH,mm,ss,±HHMM",
    "content_encoding": "Base64(UTF-8)",
    "tag_unread": "1"
  },
