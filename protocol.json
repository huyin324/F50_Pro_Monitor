    "lock": "psw_fail_num_str,login_lock_time",
    "loginfo": "loginfo",
    "versions": "Language,cr_version,wa_inner_version",
    "_main_note": "主轮询列表刻意不包含 network_information 及其 dump 内的键(Nr_*/nr_*/plmn)，也不包含 sms_capacity_info 的键(sms_nv_*)。真机验证：同一请求里显式出现这些键会把 dump 对应字段清空，导致信号/频段/短信容量全部为空——这是原版在 F50 Pro 上『硬件/连接信息缺失』的根因之一。",
    "main": "flux_realtime_rx_thrpt,flux_realtime_tx_thrpt,realtime_rx_thrpt,realtime_tx_thrpt,ppp_status,mc_modem_main_state,modem_main_state,dial_mode,opms_wan_mode,network_type,network_provider,network_provider_fullname,signalbar,network_signalbar,network_rssi,wifi_access_sta_num,wifi_onoff_state,wifi_chip1_ssid1_ssid,sim_slot,sim_pin_status,pin_status,network_simcard_roam,roam_setting_option,loginfo,cpu_temperature,battery_value,battery_charging,wan_ipaddr,ipv6_wan_ipaddr,lan_ipaddr,mac_address,monthly_rx_bytes,monthly_tx_bytes,monthly_time,realtime_rx_bytes,realtime_tx_bytes,realtime_time,flux_monthly_rx_bytes,flux_monthly_tx_bytes,flux_realtime_rx_bytes,flux_realtime_tx_bytes,flux_realtime_time,flux_clear_date,flux_data_volume_limit_switch,flux_data_volume_limit_size,flux_data_volume_limit_unit,data_volume_limit_size,data_volume_limit_unit,sms_unread_num,sms_dev_unread_num,net_select,network_net_select,dl_ambr,ul_ambr,qci,web_version,wa_inner_version,cr_version,hardware_version,model_name,iccid,imsi,imei,sim_msisdn,usb_port_switch",
