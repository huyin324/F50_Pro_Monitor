    "dump": "network_information",
    "device": "sim_msisdn,sim_imsi,sim_iccid,iccid,imsi,imei,imei_0,imei_1,wa_inner_version,wa_version,web_version,cr_version,hardware_version,model_name,market_name,network_rmcc,network_rmnc,network_provider_fullname,ppp_status,network_type,opms_wan_mode,opms_wan_auto_mode,net_select,network_net_select,wifi_chip1_ssid1_ssid,lan_ipaddr,wan_ipaddr,ipv6_wan_ipaddr,mac_address,cpu_temperature,dl_ambr,ul_ambr,LocalDomain,station_ip_addr,pdp_type_ui,apn_pdp_type,sim_slot,sim_pin_status,wifi_access_sta_num",
